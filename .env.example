# Local/Codespaces development only. Copy this file to `.env` (gitignored).
# `npm run setup:test` does this for you automatically.
#
# Production authentication, secrets and the real database are configured
# through the hosted runtime - never through this file. See README.md.

# Enables the development test identity below in place of the production
# "oai-authenticated-user-*" request headers. Explicit opt-in only: this
# must never be set in a real deployment, and nothing in the app enables it
# automatically based on hostname or any other implicit signal.
CRMUNI_LOCAL_TEST=true

# Identity attached to every request while CRMUNI_LOCAL_TEST=true. Safe
# placeholder values - change them only if you want a different local id.
CRMUNI_TEST_USER_ID=test-user
CRMUNI_TEST_USER_EMAIL=tester@crm.local
